{
  "name": "adamo-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev-secure": "next dev --turbopack --experimental-https",
    "dev": "next dev --turbopack",
    "dev:host": "next dev --turbopack --hostname landing-local.adamoservices.co",
    "build": "next build",
    "start": "next start",
    "start:host": "next start --hostname landing-local.adamoservices.co",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "lint-and-type-check": "npm run lint && npm run type-check",
    "sst:dev": "cross-env AWS_PROFILE=adamo-services npx sst dev",
    "sst:prod:deploy": "cross-env AWS_PROFILE=adamo-services npx sst deploy --stage production",
    "sst:dev:deploy": "cross-env AWS_PROFILE=adamo-services npx sst deploy --stage development"
  },
  "dependencies": {
    "@adamosuiteservices/ui": "^2.11.17",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-query": "^5.79.0",
    "aws-cdk-lib": "^2.225.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "cross-env": "^7.0.3",
    "gsap": "^3.12.7",
    "i18next": "^25.4.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.1",
    "lucide-react": "^0.503.0",
    "motion": "^12.15.0",
    "mouse-follower": "^1.1.2",
    "next": "15.3.1",
    "next-intl": "^4.0.3",
    "next-video": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "swiper": "^11.2.8",
    "tailwind-merge": "^3.2.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sst": "^3.17.23",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.7",
    "typescript": "^5"
  }
}
